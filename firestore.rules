rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permissões para aplicação KioskGuard MDM
    match /policies/{policyId} {
      allow read, write: if true;
    }
    match /devices/{deviceId} {
      allow read, write: if true;
    }
    match /incidents/{incidentId} {
      allow read, write: if true;
    }
    match /apps/{appId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
