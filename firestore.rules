rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Coleção Users
    match /users/{userId} {
      allow read, write: if true;
    }

    // Coleção Employees
    match /employees/{employeeId} {
      allow read, write: if true;
    }

    // Coleção Teams
    match /teams/{teamId} {
      allow read, write: if true;
    }

    // Coleção Devices
    match /devices/{deviceId} {
      allow read, write: if true;
    }

    // Coleção Applications
    match /applications/{appId} {
      allow read, write: if true;
    }

    // Coleção Policies
    match /policies/{policyId} {
      allow read, write: if true;
    }

    // Coleção PolicyAssignments
    match /policyAssignments/{assignmentId} {
      allow read, write: if true;
    }

    // Coleção Alerts
    match /alerts/{alertId} {
      allow read, write: if true;
    }

    // Coleção Events (Auditoria de Ações e Simulação de Aparelhos)
    match /events/{eventId} {
      allow read, create: if true;
      allow update, delete: if true;
    }

    // Coleção Configurações do Sistema
    match /systemSettings/{settingId} {
      allow read, write: if true;
    }

    // Fallback padrão
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

